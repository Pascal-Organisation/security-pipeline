# /etc/app-deploy/<app>.conf — root:root 0644. Sourced by app-deploy.
# Copy, rename to the app name (solar.conf, ...), adjust.

# Image repository the host will EVER run for this app. Fixed here, never taken from elsewhere.
IMAGE=ghcr.io/pascal-organisation/myapp
# Repository whose main branch must have built the image.
REPOSITORY=Pascal-Organisation/myapp

DEPLOY_DIR=/srv/myapp
SERVICES="web"

# Variable names compose reads from ${DEPLOY_DIR}/image.env
IMAGE_VAR=APP_IMAGE
BUILT_VAR=APP_BUILT_AT

# Optional: compose file shipped inside the image, so compose changes deploy with the code.
COMPOSE_FROM_IMAGE=
# Optional: directory inside the image copied over DEPLOY_DIR (compose + config files).
# Never secrets/ or image.env; app-deploy refuses those.
BUNDLE_FROM_IMAGE=
# Optional: executable run before switching (exit != 0 aborts the deploy).
BACKUP_HOOK=
HEALTH_TIMEOUT=300
MAX_RESTARTS=3
