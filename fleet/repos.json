{
  "org": "Pascal-Organisation",
  "org_actions": {
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "selected_actions": {
      "github_owned_allowed": true,
      "verified_allowed": false,
      "patterns_allowed": [
        "Pascal-Organisation/*",
        "sigstore/cosign-installer@*",
        "ossf/scorecard-action@*"
      ]
    }
  },
  "security_and_analysis_public": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "dependabot_security_updates": "enabled"
  },
  "repos": [
    {
      "name": "workingrepo",
      "profile": "ci-only",
      "ring": "canary",
      "gate_check": "Security / security-gate",
      "visibility": "private"
    },
    {
      "name": "anmeldungunihandball",
      "profile": "ci-only",
      "ring": "canary",
      "gate_check": "Security / security-gate",
      "visibility": "public"
    },
    {
      "name": "homelab",
      "profile": "ci-only",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "visibility": "private"
    },
    {
      "name": "knowledgebase",
      "profile": "ci-only",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "visibility": "private"
    },
    {
      "name": "pascalhaag-website",
      "profile": "container-pull",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "visibility": "private"
    },
    {
      "name": "websiteghana",
      "profile": "static-ftps",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "note": "FTPS-Upload GitHub-hosted (deploy-static.yml); Prod-Release per release-*-Tag.",
      "visibility": "private"
    },
    {
      "name": "solar",
      "profile": "container-pull",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "extra_required_checks": [
        "Lint & test"
      ],
      "visibility": "public"
    },
    {
      "name": "bahnbot",
      "profile": "container-pull",
      "ring": "stable",
      "gate_check": "Security / security-gate",
      "visibility": "private"
    },
    {
      "name": "security-pipeline",
      "profile": "ci-only",
      "ring": "stable",
      "gate_check": "ci / security-gate",
      "note": "Das Pipeline-Repo selbst; ruft ci.yml lokal auf, kein Pin.",
      "visibility": "public"
    }
  ]
}
